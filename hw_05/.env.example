AIRFLOW_VM_USER=ubuntu
AIRFLOW_ADMIN_USER=test_admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_HOST=
AIRFLOW_HOME=/etc/airflow
AIRFLOW_DAGS_FOLDER=/home/airflow/dags

# Настройки S3
S3_ENDPOINT_URL=https://storage.yandexcloud.net

# Бакет для данных (исходные данные, которые обрабатывает Airflow)
S3_DATA_BUCKET=   #  бакет с данными

# Бакет для Airflow (логи, даги, артефакты, метаданные)
S3_AIRFLOW_BUCKET=

# Ключи доступа (общие для обоих бакетов)
S3_ACCESS_KEY=
S3_SECRET_KEY=

GITHUB_TOKEN=
GITHUB_REPO=
PRIVATE_KEY_PATH=